+	private promptIfNewUpdate(version: string): void {
+		const key = 'update/lastNotifiedProductVersion';
+		if (this.storageService.get(key, StorageScope.APPLICATION) === version) {
+			return;
+		}
+
+		this.storageService.store(key, version, StorageScope.APPLICATION, StorageTarget.MACHINE);
+		this.notificationService.prompt(
+			Severity.Info,
+			nls.localize('covexcodeUpdateAvailable', "A new version of {0} is available ({1}). Update now?", this.productService.nameLong, version),
+			[{
+				label: nls.localize('updateNow', "Update"),
+				run: () => this.updateService.downloadUpdate(true)
+			}, {
+				label: nls.localize('updateLater', "Later"),
+				run: () => { }
+			}]
+		);
+	}
+
+	/**
+	 * macOS goes straight from checking to downloading; it never enters
+	 * AvailableForDownload. Without this prompt a failed background download
+	 * (the network errors users actually hit) produced no UI at all. The
+	 * download-page button gives them a path that does not depend on the
+	 * updater's single large GitHub request succeeding.
+	 */
+	private promptIfDownloading(version: string): void {
+		const key = 'update/lastDownloadingNotifiedProductVersion';
+		if (
+			this.storageService.get(key, StorageScope.APPLICATION) === version ||
+			this.storageService.get('update/lastNotifiedProductVersion', StorageScope.APPLICATION) === version
+		) {
+			return;
+		}
+
+		this.storageService.store(key, version, StorageScope.APPLICATION, StorageTarget.MACHINE);
+		this.notificationService.prompt(
+			Severity.Info,
+			nls.localize('covexcodeUpdateDownloading', "{0} {1} is available and is downloading. If it does not finish, get it from the download page.", this.productService.nameLong, version),
+			[{
+				label: nls.localize('openDownloadPage', "Download Page"),
+				run: () => this.openerService.open(URI.parse('https://covexcode.com/download'))
+			}, {
+				label: nls.localize('updateLater', "Later"),
+				run: () => { }
+			}]
+		);
+	}
+
+	private promptIfUpdateReady(version: string): void {
+		const key = 'update/lastReadyNotifiedProductVersion';
+		if (this.storageService.get(key, StorageScope.APPLICATION) === version) {
+			return;
+		}
+
+		this.storageService.store(key, version, StorageScope.APPLICATION, StorageTarget.MACHINE);
+		this.notificationService.prompt(
+			Severity.Info,
+			nls.localize('covexcodeUpdateReady', "{0} {1} is ready to install. Restart to update.", this.productService.nameLong, version),
+			[{
+				label: nls.localize('covexcodeRestartToUpdate', "Restart to Update"),
+				run: () => this.updateService.quitAndInstall()
+			}, {
+				label: nls.localize('updateLater', "Later"),
+				run: () => { }
+			}]
+		);
+	}
+
 	private registerGlobalActivityActions(): void {
 		CommandsRegistry.registerCommand('update.check', () => this.updateService.checkForUpdates(true));
 		CommandsRegistry.registerCommand('update.checking', () => { });
