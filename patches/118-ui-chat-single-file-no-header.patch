@@ -71,12 +71,22 @@
 			? this.content.multiDiffData.map(d => d)
 			: constObservable(this.content.multiDiffData);
 
-		const headerDomNode = $('.checkpoint-file-changes-summary-header');
-		this.domNode = $('.checkpoint-file-changes-summary', undefined, headerDomNode);
-		this.domNode.tabIndex = 0;
-		this.isCollapsed = content?.collapsed ?? false;
+		// A part that carries a single changed file needs no header: the one row
+		// already names the file and draws its own +N/-N counts, so "Changed 1
+		// file" stacked above it is pure chrome. The header -- collapse control,
+		// "Open Changes", contributed buttons -- is only rendered when there is
+		// more than one file to collapse or act on.
+		const singleFile = this.diffData.get().resources.length === 1;
+		this.domNode = singleFile
+			? $('.checkpoint-file-changes-summary.single-file-changes')
+			: $('.checkpoint-file-changes-summary');
+		this.domNode.tabIndex = singleFile ? -1 : 0;
+		this.isCollapsed = singleFile ? false : (content?.collapsed ?? false);
 
-		this._register(this.renderHeader(headerDomNode));
+		if (!singleFile) {
+			const headerDomNode = this.domNode.appendChild($('.checkpoint-file-changes-summary-header'));
+			this._register(this.renderHeader(headerDomNode));
+		}
 		this._register(this.renderFilesList(this.domNode));
 	}
 
