+
+import * as dom from '../../../../../base/browser/dom.js';
+import { Disposable, DisposableStore } from '../../../../../base/common/lifecycle.js';
+import { IChatRequestViewModel, IChatResponseViewModel, IChatViewModel, isRequestVM, isResponseVM } from '../../common/model/chatViewModel.js';
+import { ChatTreeItem } from '../chat.js';
+import { stringifyItem } from '../actions/chatActions.js';
+import type { ChatListItemRenderer } from './chatListRenderer.js';
+
+export class ChatSelectionCopyController extends Disposable {
+	private trackedAnchorItem: ChatTreeItem | undefined;
+	private trackedFocusItem: ChatTreeItem | undefined;
+	private caretItem: ChatTreeItem | undefined;
+	private isMouseDown = false;
+	private selectAllActive = false;
+	private autoScrollRaf: number | null = null;
+	private autoScrollSpeed = 0;
+	private lastMouseX = 0;
+	private lastMouseY = 0;
+
+	constructor(
+		private readonly getViewModel: () => IChatViewModel | undefined,
+		private readonly treeDomNode: HTMLElement,
+		private readonly renderer: ChatListItemRenderer,
+		private readonly getTree?: () => any,
+	) {
+		super();
+		this.registerListeners();
+	}
+
+	private scrollBy(delta: number): void {
+		const tree = this.getTree ? this.getTree() : undefined;
+		if (tree && typeof tree.scrollTop === 'number') {
+			tree.scrollTop += delta;
+			return;
+		}
+		const scrollable = this.treeDomNode.querySelector<HTMLElement>('.monaco-scrollable-element');
+		if (scrollable) {
+			scrollable.scrollTop += delta;
+		}
+	}
+
+	private startAutoScroll(): void {
+		if (this.autoScrollRaf !== null) {
+			return;
+		}
+		const win = dom.getWindow(this.treeDomNode);
+		const loop = () => {
+			if (!this.isMouseDown || this.autoScrollSpeed === 0) {
+				this.stopAutoScroll();
+				return;
+			}
+			this.scrollBy(this.autoScrollSpeed);
+			const sel = win.getSelection();
+			if (sel && sel.rangeCount > 0 && (sel as any).extend) {
+				const rect = this.treeDomNode.getBoundingClientRect();
+				const clampX = Math.max(rect.left + 24, Math.min(rect.right - 24, this.lastMouseX || ((rect.left + rect.right) / 2)));
+				const clampY = this.autoScrollSpeed < 0 ? rect.top + 8 : rect.bottom - 8;
+				const doc = win.document;
+				const range = (doc as any).caretRangeFromPoint ? (doc as any).caretRangeFromPoint(clampX, clampY) : null;
+				let extended = false;
+				if (range && range.startContainer) {
+					try {
+						(sel as any).extend(range.startContainer, range.startOffset);
+						extended = true;
+					} catch {}
+				}
+				if (!extended) {
+					const rows = this.treeDomNode.querySelectorAll('.monaco-list-row');
+					if (rows.length > 0) {
+						const targetRow = this.autoScrollSpeed < 0 ? rows[0] : rows[rows.length - 1];
+						try {
+							(sel as any).extend(targetRow, this.autoScrollSpeed < 0 ? 0 : targetRow.childNodes.length);
+						} catch {}
+					}
+				}
+			}
+			this.autoScrollRaf = win.requestAnimationFrame(loop);
+		};
+		this.autoScrollRaf = win.requestAnimationFrame(loop);
+	}
+
+	private stopAutoScroll(): void {
+		if (this.autoScrollRaf !== null) {
+			const win = dom.getWindow(this.treeDomNode);
+			win.cancelAnimationFrame(this.autoScrollRaf);
+			this.autoScrollRaf = null;
+		}
+		this.autoScrollSpeed = 0;
+	}
+
+	private get rowsContainer(): HTMLElement | null {
+		return this.treeDomNode.querySelector<HTMLElement>('.monaco-list-rows');
+	}
+
+	private registerListeners(): void {
+		const store = this._register(new DisposableStore());
+		const win = dom.getWindow(this.treeDomNode);
+
+		store.add(dom.addDisposableListener(this.treeDomNode, 'mousedown', (e: MouseEvent) => {
+			if (e.button !== 0) {
+				return;
+			}
+			this.isMouseDown = true;
+			this.selectAllActive = false;
+
+			const target = e.target as HTMLElement | null;
+			if (!target || target.closest('button, a, input, textarea, .monaco-toolbar, .monaco-editor')) {
+				this.clearTrackedState();
+				return;
+			}
+
+			const clickedItem = this.itemFromElement(target);
+			if (e.shiftKey && this.caretItem) {
+				this.trackedAnchorItem = this.caretItem;
+				this.trackedFocusItem = clickedItem;
+			} else {
+				this.trackedAnchorItem = clickedItem;
+				this.trackedFocusItem = clickedItem;
+			}
+		}));
+
+		store.add(dom.addDisposableListener(win, 'mousemove', (e: MouseEvent) => {
+			if (!this.isMouseDown) {
+				return;
+			}
+			this.lastMouseX = e.clientX;
+			this.lastMouseY = e.clientY;
+			const rect = this.treeDomNode.getBoundingClientRect();
+			const threshold = 40;
+			if (e.clientY < rect.top + threshold) {
+				const dist = Math.max(1, (rect.top + threshold) - e.clientY);
+				this.autoScrollSpeed = -Math.min(32, Math.max(3, dist * 0.5));
+				this.startAutoScroll();
+			} else if (e.clientY > rect.bottom - threshold) {
+				const dist = Math.max(1, e.clientY - (rect.bottom - threshold));
+				this.autoScrollSpeed = Math.min(32, Math.max(3, dist * 0.5));
+				this.startAutoScroll();
+			} else {
+				this.stopAutoScroll();
+			}
+		}));
+
+		const handleMouseRelease = () => {
+			this.stopAutoScroll();
+			this.isMouseDown = false;
+			const sel = win.getSelection();
+			if (sel?.isCollapsed) {
+				if (this.trackedAnchorItem) {
+					this.caretItem = this.trackedAnchorItem;
+				}
+				this.clearTrackedState();
+			}
+		};
+
+		store.add(dom.addDisposableListener(win, 'mouseup', handleMouseRelease));
+		store.add(dom.addDisposableListener(win, 'blur', handleMouseRelease));
+		store.add(dom.addDisposableListener(win, 'dragend', handleMouseRelease));
+		store.add(dom.addDisposableListener(win, 'pointercancel', handleMouseRelease));
+
+		store.add(dom.addDisposableListener(win.document, 'selectionchange', () => {
+			const sel = win.getSelection();
+			if (!sel) {
+				return;
+			}
+
+			const isInsideTree = (node: Node | null) => !!node && this.treeDomNode.contains(node);
+			if (!isInsideTree(sel.anchorNode) && !isInsideTree(sel.focusNode)) {
+				this.caretItem = undefined;
+				return;
+			}
+
+			if (!sel.isCollapsed && sel.focusNode) {
+				const isForward = !!sel.anchorNode && !!(sel.anchorNode.compareDocumentPosition(sel.focusNode) & Node.DOCUMENT_POSITION_FOLLOWING);
+				const el = this.boundaryToElement(sel.focusNode, sel.focusOffset, isForward);
+				const item = this.itemFromElement(el);
+				if (item) {
+					this.trackedFocusItem = item;
+				}
+			} else if (!this.isMouseDown && sel.isCollapsed) {
+				this.clearTrackedState();
+				this.selectAllActive = false;
+			}
+		}));
+
+		store.add(dom.addDisposableListener(this.treeDomNode, 'copy', (e: ClipboardEvent) => {
+			this.handleCopy(e, win);
+		}));
+	}
+
+	public onDidChangeViewModel(): void {
+		this.clearTrackedState();
+		this.caretItem = undefined;
+		this.selectAllActive = false;
+	}
+
+	public triggerSelectAll(): void {
+		const win = dom.getWindow(this.treeDomNode);
+		const sel = win.getSelection();
+		const rows = this.rowsContainer;
+		if (sel && rows) {
+			sel.selectAllChildren(rows);
+			this.selectAllActive = true;
+		}
+	}
+
+	private handleCopy(e: ClipboardEvent, win: Window): void {
+		const target = e.target as HTMLElement | null;
+		if (target?.closest('.monaco-editor, textarea, input')) {
+			return;
+		}
+
+		const viewModel = this.getViewModel();
+		const allItems = viewModel?.getItems() ?? [];
+		if (allItems.length === 0) {
+			return;
+		}
+
+		const sel = win.getSelection();
+		if (!sel || sel.rangeCount === 0) {
+			return;
+		}
+		const range = sel.getRangeAt(0);
+		const rows = this.rowsContainer;
+
+		const isLiveSelectAll = this.selectAllActive && !!rows && (
+			range.startContainer === rows &&
+			range.startOffset === 0 &&
+			range.endContainer === rows &&
+			range.endOffset >= rows.childNodes.length - 1
+		);
+
+		if (isLiveSelectAll) {
+			try {
+				const payload = allItems
+					.filter((item): item is (IChatRequestViewModel | IChatResponseViewModel) => isRequestVM(item) || (isResponseVM(item) && !item.errorDetails?.responseIsFiltered))
+					.map(item => stringifyItem(item, true))
+					.filter(Boolean)
+					.join('\n\n');
+
+				if (payload) {
+					e.preventDefault();
+					e.clipboardData?.setData('text/plain', payload);
+				}
+			} catch (err) {
+				console.error('[ChatCopyController] Select-all serialization failed:', err);
+			}
+			return;
+		}
+
+		if (sel.isCollapsed) {
+			return;
+		}
+
+		const startEl = this.boundaryToElement(range.startContainer, range.startOffset, false);
+		const endEl = this.boundaryToElement(range.endContainer, range.endOffset, true);
+
+		const startItem = this.trackedAnchorItem ?? this.itemFromElement(startEl);
+		const endItem = this.trackedFocusItem ?? this.itemFromElement(endEl);
+
+		if (!startItem || !endItem || startItem === endItem) {
+			return;
+		}
+
+		const indexA = allItems.indexOf(startItem);
+		const indexB = allItems.indexOf(endItem);
+		if (indexA === -1 || indexB === -1) {
+			return;
+		}
+
+		const firstIdx = Math.min(indexA, indexB);
+		const lastIdx = Math.max(indexA, indexB);
+
+		try {
+			const chunks: string[] = [];
+			for (let i = firstIdx; i <= lastIdx; i++) {
+				const item = allItems[i];
+				if (isResponseVM(item) && item.errorDetails?.responseIsFiltered) {
+					continue;
+				}
+
+				const isStartEdge = (i === firstIdx);
+				const isEndEdge = (i === lastIdx);
+
+				if (isStartEdge || isEndEdge) {
+					const rowEl = this.renderer.itemRowMap.get(item);
+					const hasIntersectingCodeBlock = rowEl
+						? Array.from(rowEl.querySelectorAll<HTMLElement>('.monaco-editor')).some(ed => range.intersectsNode(ed))
+						: false;
+
+					const boundaryNode = isStartEdge ? range.startContainer : range.endContainer;
+					if (!rowEl || !rowEl.contains(boundaryNode) || hasIntersectingCodeBlock) {
+						chunks.push(stringifyItem(item as any, true));
+					} else {
+						const rawEdgeText = this.extractEdgeText(range, rowEl, isStartEdge ? 'start' : 'end');
+						chunks.push(this.formatTurnChunk(item, rawEdgeText));
+					}
+				} else {
+					chunks.push(stringifyItem(item as any, true));
+				}
+			}
+
+			const payload = chunks.filter(Boolean).join('\n\n');
+			if (payload) {
+				e.preventDefault();
+				e.clipboardData?.setData('text/plain', payload);
+			}
+		} catch (err) {
+			console.error('[ChatCopyController] Multi-turn serialization failed:', err);
+		}
+	}
+
+	private extractEdgeText(range: Range, rowEl: HTMLElement, side: 'start' | 'end'): string {
+		const edgeRange = range.cloneRange();
+		if (side === 'start') {
+			edgeRange.setEnd(rowEl, rowEl.childNodes.length);
+		} else {
+			edgeRange.setStart(rowEl, 0);
+		}
+
+		const fragment = edgeRange.cloneContents();
+		fragment.querySelectorAll('.monaco-toolbar, .chat-item-actions, .sr-only, .codicon').forEach(el => el.remove());
+		fragment.querySelectorAll('p, li, div, h1, h2, h3, h4, h5, h6, pre, br').forEach(el => el.after('\n'));
+
+		return (fragment.textContent || '').trim();
+	}
+
+	private formatTurnChunk(item: ChatTreeItem, text: string): string {
+		if (!text) return '';
+		const username = (isRequestVM(item) || isResponseVM(item)) && item.username ? `${item.username}: ` : '';
+		return `${username}${text}`;
+	}
+
+	private boundaryToElement(node: Node, offset: number, isEnd: boolean): Element | null {
+		if (node.nodeType === Node.ELEMENT_NODE) {
+			const el = node as HTMLElement;
+			const targetOffset = isEnd ? offset - 1 : offset;
+			if (targetOffset < 0) {
+				return (el.previousElementSibling as HTMLElement | null)?.lastElementChild ?? el.previousElementSibling ?? el;
+			}
+			if (targetOffset >= el.childNodes.length) {
+				return (el.lastElementChild as HTMLElement | null) ?? el;
+			}
+			const child = el.childNodes[targetOffset];
+			return (child instanceof Element) ? child : child?.parentElement ?? el;
+		}
+		return node.parentElement;
+	}
+
+	private itemFromElement(el: Element | null): ChatTreeItem | undefined {
+		const row = el?.closest('.monaco-list-row') as HTMLElement | null;
+		return row ? this.renderer.rowItemMap.get(row) : undefined;
+	}
+
+	private clearTrackedState(): void {
+		this.trackedAnchorItem = undefined;
+		this.trackedFocusItem = undefined;
+	}
+}
