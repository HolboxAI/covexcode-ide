diff --git a/src/vs/workbench/contrib/chat/browser/widget/media/chat.css b/src/vs/workbench/contrib/chat/browser/widget/media/chat.css
--- a/src/vs/workbench/contrib/chat/browser/widget/media/chat.css
+++ b/src/vs/workbench/contrib/chat/browser/widget/media/chat.css
@@ -4507,3 +4507,101 @@ a[href*="permission.review"] {
 }
 
 .interactive-session a[data-href*="permission"]:focus-visible,
+
+/*
+ * covexcode-ide: Cursor/Antigravity-style 56 × 56 px square image thumbnail chips
+ * in the chat INPUT staging area (above the text box).  Images pasted with
+ * Cmd+V / Ctrl+V or drag-dropped show as object-fit: cover square cards with a
+ * hoverable ✕ remove button in the top-right corner.
+ *
+ * Scope is intentionally limited to .interactive-input-part so the collapsible
+ * IO history cards keep their own larger 88 × 88 upstream styles.
+ */
+
+/* ── Square chip shell ─────────────────────────────────────────── */
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment {
+	box-sizing: border-box;
+	width: 56px;
+	height: 56px;
+	border-radius: 6px;
+	padding: 0;
+	overflow: hidden;
+	position: relative;
+	border: 1px solid var(--vscode-chat-requestBorder,
+	               var(--vscode-widget-border,
+	               rgba(128, 128, 128, 0.35)));
+	background-color: var(--vscode-input-background);
+	transition: border-color 0.12s ease, box-shadow 0.12s ease;
+}
+
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment:hover {
+	border-color: var(--vscode-focusBorder, rgba(128, 128, 128, 0.7));
+	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
+}
+
+/* ── Pill container fills the chip entirely ─────────────────────── */
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment
+	.chat-attached-context-pill {
+	width: 100%;
+	height: 100%;
+	padding: 0;
+	margin: 0;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+}
+
+/* ── Thumbnail: object-fit cover, fills the whole 56 × 56 square ── */
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment
+	.chat-attached-context-pill-image {
+	width: 100%;
+	height: 100%;
+	border-radius: 5px;
+	margin: 0;
+	object-fit: cover;
+	display: block;
+}
+
+/* ── Filename label: hidden — the thumbnail is the identifier ────── */
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment
+	.chat-attached-context-custom-text {
+	display: none;
+}
+
+/* ── Remove button (✕): top-right, revealed on hover ─────────────── */
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment
+	.monaco-button.codicon-close {
+	position: absolute !important;
+	top: 2px;
+	right: 2px;
+	width: 16px;
+	height: 16px;
+	border-radius: 50%;
+	background: rgba(0, 0, 0, 0.55) !important;
+	color: #fff !important;
+	font-size: 10px !important;
+	opacity: 0;
+	transition: opacity 0.1s ease;
+	display: flex !important;
+	align-items: center;
+	justify-content: center;
+}
+
+.interactive-session .interactive-input-part
+	.chat-attached-context
+	.chat-attached-context-attachment.image-attachment:hover
+	.monaco-button.codicon-close {
+	opacity: 1;
+}
