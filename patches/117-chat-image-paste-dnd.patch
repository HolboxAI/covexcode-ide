 			DropIntoEditorController.get(this._inputEditor)?.clearWidgets();
 		}));
 
+		// covexcode-ide: Paste images from clipboard → attach as square thumbnail chips.
+		// Mirrors the Cursor / Antigravity UX: Cmd+V (macOS) / Ctrl+V (Win/Linux) with
