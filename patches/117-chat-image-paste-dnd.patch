+		// raw bytes into the text editor.  Text pastes fall through unmodified.
+		this._register(dom.addDisposableListener(this._inputEditorElement, 'paste', async (e: ClipboardEvent) => {
+			const items = Array.from(e.clipboardData?.items ?? []);
+			const imageItems = items.filter(item => item.type.startsWith('image/'));
+			if (imageItems.length === 0) {
+				return; // no images on the clipboard — normal text paste can proceed
