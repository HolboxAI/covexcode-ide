+	protected override doQuitAndInstall(): void {
+		const pending = this.availableUpdate;
+
+		if (!pending) {
+			this.logService.warn('update#linux - no staged update to apply');
+			return;
+		}
+
+		const binary = path.basename(process.execPath);
+		const scriptPath = path.join(tmpdir(), `covexcode-apply-${process.pid}.sh`);
+		const script = `#!/bin/sh
+set -eu
+exec >> /tmp/covexcode-apply-update.log 2>&1
+while kill -0 "$1" 2>/dev/null; do sleep 1; done
+cp -a "$3"/. "$2"/
+rm -rf "$4"
+rm -f "$0"
+exec "$2/${binary}"
+`;
+
+		try {
+			writeFileSync(scriptPath, script, { mode: 0o700 });
+		} catch (error) {
+			this.logService.error('update#linux - could not write the apply-update helper', error);
+			return;
+		}
+
+		const child = spawn('/bin/sh', [scriptPath, String(process.pid), pending.appDir, pending.appRoot, pending.cacheDir], {
+			detached: true,
+			stdio: 'ignore',
+		});
+		child.unref();
+	}
+}
+
+function extractTarball(tarball: string, target: string): Promise<void> {
+	return new Promise((resolve, reject) => {
+		const child = spawn('/bin/tar', ['-xzf', tarball, '-C', target], { stdio: 'ignore' });
+
+		child.once('error', reject);
+		child.once('exit', code => code === 0 ? resolve() : reject(new Error(`tar exited with code ${code}`)));
+	});
+}
+
+async function findAppRoot(stageDir: string, binary: string): Promise<string> {
+	const candidates = [stageDir];
+
+	for (const entry of await readdir(stageDir, { withFileTypes: true })) {
+		if (entry.isDirectory()) {
+			candidates.push(path.join(stageDir, entry.name));
+		}
+	}
+
+	for (const candidate of candidates) {
+		try {
+			await access(path.join(candidate, binary), constants.X_OK);
+			return candidate;
+		} catch {
+			// keep looking
+		}
+	}
+
+	throw new Error(`could not find ${binary} in the update archive`);
 }
