+
+/* covexcode: docked post-turn Review Bar above chat input */
+.interactive-session > .covexcode-review-bar {
+	margin: 0 12px 6px 12px;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-contrastBorder, transparent));
+	border-radius: 6px;
+	background-color: var(--vscode-editorWidget-background);
+	color: var(--vscode-foreground);
+	font-size: 12px;
+	overflow: hidden;
+	flex-shrink: 0;
+}
+
+.interactive-session > .covexcode-review-bar .covexcode-review-header {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 4px;
+	padding: 5px 8px;
+	background-color: var(--vscode-sideBarSectionHeader-background, var(--vscode-editorWidget-background));
+}
+
+.interactive-session > .covexcode-review-bar .covexcode-review-toggle {
+	display: inline-flex;
+	align-items: center;
+	gap: 3px;
+	min-width: 0;
+	overflow: hidden;
+	background: transparent;
+	border: none;
+	color: var(--vscode-foreground);
+	font: inherit;
+	font-weight: 600;
+	padding: 2px;
+	border-radius: 4px;
+	cursor: pointer;
+}
+
+.interactive-session > .covexcode-review-bar .covexcode-review-count {
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.interactive-session > .covexcode-review-bar .covexcode-review-toggle:hover,
+.interactive-session > .covexcode-review-bar .covexcode-review-toggle:focus-visible {
+	background-color: var(--vscode-list-hoverBackground);
+	outline: 1px solid var(--vscode-focusBorder);
+}
+
+.interactive-session > .covexcode-review-bar .covexcode-review-bulk-actions {
