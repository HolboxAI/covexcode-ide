+/* covexcode: docked post-turn Review Bar above chat input (Antigravity-style drop-up) */
+.interactive-session > .covexcode-review-bar {
+	margin: 0 12px 6px 12px;
+	border: 1px solid var(--vscode-widget-border, rgba(255, 255, 255, 0.08));
+	border-radius: 8px;
+	background-color: var(--vscode-editorWidget-background, #18181b);
+	color: var(--vscode-foreground);
+	font-size: 11.5px;
+	overflow: hidden;
+	flex-shrink: 0;
+	box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
+}
+
+.interactive-session > .covexcode-review-bar:not([style*="display: none"]) + .interactive-input-part,
+.interactive-session > .covexcode-review-bar.visible + .interactive-input-part {
+	padding-top: 0;
+}
+
+/* Header bar: docked at bottom of the review widget, flush above chat input */
+.interactive-session > .covexcode-review-bar .covexcode-review-header {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 6px;
+	padding: 3px 8px;
+	min-height: 28px;
+	box-sizing: border-box;
+	background-color: var(--vscode-editorWidget-background, #18181b);
+}
+
+/* Toggle button with file icon, count, and chevron */
+.interactive-session > .covexcode-review-bar .covexcode-review-toggle {
