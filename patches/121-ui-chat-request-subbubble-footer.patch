diff --git a/src/vs/workbench/contrib/chat/browser/widget/media/chat.css b/src/vs/workbench/contrib/chat/browser/widget/media/chat.css
index abbb8e4..e6934af 100644
--- a/src/vs/workbench/contrib/chat/browser/widget/media/chat.css
+++ b/src/vs/workbench/contrib/chat/browser/widget/media/chat.css
@@ -4381,3 +4381,103 @@ have to be updated for changes to the rules above, or to support more deeply nes
 .chat-input-container .chat-input-toolbars .codicon-debug-disconnect {
 	color: var(--vscode-charts-green, #3fb950) !important;
 }
+
+/* Antigravity-style sub-bubble request footer */
+.interactive-item-container.interactive-request .chat-request-footer {
+	display: flex;
+	align-items: center;
+	justify-content: flex-end;
+	gap: 6px;
+	margin-top: 2px;
+	margin-right: 4px;
+	opacity: 0;
+	transition: opacity 120ms ease-in-out;
+	user-select: none;
+}
+
+.interactive-item-container.interactive-request:not(.editing):hover .chat-request-footer,
+.interactive-item-container.interactive-request:not(.editing):focus-within .chat-request-footer {
+	opacity: 1;
+}
+
+.interactive-item-container.interactive-request.editing .chat-request-footer,
+.interactive-item-container.interactive-request .chat-request-footer.hidden {
+	display: none !important;
+}
+
+.interactive-item-container.interactive-request .chat-request-timestamp {
+	font-size: 11px;
+	color: var(--vscode-descriptionForeground);
+	cursor: default;
+	line-height: 1;
+	margin-right: 2px;
+}
+
+.interactive-item-container.interactive-request .chat-request-footer .monaco-toolbar {
+	height: 20px;
+}
+
+.interactive-item-container.interactive-request .chat-request-footer .monaco-action-bar .actions-container {
+	gap: 2px;
+	height: 20px;
+	align-items: center;
+}
+
+.interactive-item-container.interactive-request .chat-request-footer .action-label {
+	width: 20px;
+	height: 20px;
+	padding: 2px;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	border-radius: 4px;
+	border: none;
+	background: transparent;
+	margin: 0;
+}
+
+.interactive-item-container.interactive-request .chat-request-footer .action-label:hover {
+	background-color: var(--vscode-toolbar-hoverBackground);
+}
+
+.interactive-item-container.interactive-request .chat-request-footer .action-label .codicon {
+	font-size: 14px;
+	color: var(--vscode-icon-foreground);
+}
+
+.interactive-item-container.interactive-request .request-hover {
+	display: none !important;
+}
+
+/* Copy button tick feedback styles in request footer */
+.interactive-item-container .chat-request-footer .monaco-toolbar .menu-entry.chat-copy-action .action-label {
+	position: relative;
+	overflow: hidden;
+}
+
+.interactive-item-container .chat-request-footer .monaco-toolbar .menu-entry.chat-copy-action .chat-copy-action-icons {
+	display: grid;
+	place-items: center;
+	width: 16px;
+	height: 16px;
+}
+
+.interactive-item-container .chat-request-footer .monaco-toolbar .menu-entry.chat-copy-action .chat-copy-action-icon {
+	grid-area: 1 / 1;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	line-height: 1;
+	opacity: 0;
+	transform: scale(0.92);
+	transition:
+		opacity 140ms cubic-bezier(0.2, 0, 0, 1),
+		transform 140ms cubic-bezier(0.2, 0, 0, 1);
+	will-change: opacity, transform;
+}
+
+.interactive-item-container .chat-request-footer .monaco-toolbar .menu-entry.chat-copy-action:not(.copied) .chat-copy-action-icon-copy,
+.interactive-item-container .chat-request-footer .monaco-toolbar .menu-entry.chat-copy-action.copied .chat-copy-action-icon-copied {
+	opacity: 1;
+	transform: scale(1);
+}
