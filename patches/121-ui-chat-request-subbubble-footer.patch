+interface ITurnFileChange {
+	readonly path: string;
+	readonly action: string;
+	readonly turn?: number;
+}
+
+interface IConfirmUndoResult {
+	readonly confirmed: boolean;
+	readonly revertFiles: boolean;
+}
+
+function resolveChangeResourceUri(changePath: string, workspaceFolder: URI | undefined): URI | undefined {
+	const trimmed = changePath.trim();
+	if (!trimmed) {
+		return undefined;
+	}
+	if (trimmed.startsWith('/') || /^[A-Za-z]:[\\/]/.test(trimmed)) {
+		return URI.file(trimmed);
+	}
+	return workspaceFolder ? joinPath(workspaceFolder, trimmed.replace(/\\/g, '/')) : undefined;
+}
+
+function showConfirmUndoModal(widget: IChatWidget | undefined, changes: readonly ITurnFileChange[]): Promise<IConfirmUndoResult> {
+	const sessionHost = (widget?.domNode.querySelector('.interactive-session') as HTMLElement | null) ?? widget?.domNode;
+	if (!sessionHost) {
+		return Promise.resolve({ confirmed: true, revertFiles: true });
+	}
+
+	sessionHost.querySelectorAll('.chat-confirm-undo-backdrop').forEach(el => el.remove());
+
+	const doc = sessionHost.ownerDocument;
+	return new Promise<IConfirmUndoResult>(resolve => {
+		const backdrop = doc.createElement('div');
+		backdrop.className = 'chat-confirm-undo-backdrop';
+
+		const card = doc.createElement('div');
+		card.className = 'chat-confirm-undo-card';
+		card.setAttribute('role', 'dialog');
+		card.setAttribute('aria-modal', 'true');
+		backdrop.appendChild(card);
+
+		const header = doc.createElement('div');
+		header.className = 'confirm-undo-header';
+		const titleEl = doc.createElement('div');
+		titleEl.className = 'confirm-undo-title';
+		titleEl.textContent = localize('chat.confirmUndo.title', "Confirm Undo");
+		const closeBtn = doc.createElement('button');
+		closeBtn.type = 'button';
+		closeBtn.className = 'confirm-undo-close';
+		closeBtn.setAttribute('aria-label', localize('chat.confirmUndo.close', "Close"));
+		closeBtn.textContent = '✕';
+		header.append(titleEl, closeBtn);
+		card.appendChild(header);
+
+		const subtitle = doc.createElement('div');
+		subtitle.className = 'confirm-undo-subtitle';
+		subtitle.textContent = changes.length > 0
+			? localize('chat.confirmUndo.subtitleWithChanges', "Confirming this undo action will make the following changes:")
+			: localize('chat.confirmUndo.subtitleNoChanges', "Confirming this undo action will remove this message and all subsequent messages from the chat.");
+		card.appendChild(subtitle);
+
+		let checkbox: HTMLInputElement | undefined;
+		if (changes.length > 0) {
+			const checkboxRow = doc.createElement('label');
+			checkboxRow.className = 'confirm-undo-checkbox-row';
+			checkbox = doc.createElement('input');
+			checkbox.type = 'checkbox';
+			checkbox.className = 'confirm-undo-checkbox';
+			checkbox.checked = true;
+			const checkboxLabel = doc.createElement('span');
+			checkboxLabel.textContent = localize('chat.confirmUndo.revertFiles', "Revert file changes");
+			checkboxRow.append(checkbox, checkboxLabel);
+			card.appendChild(checkboxRow);
+
+			const fileList = doc.createElement('div');
+			fileList.className = 'confirm-undo-file-list';
+			for (const change of changes) {
+				const item = doc.createElement('div');
+				item.className = 'confirm-undo-file-item';
+				const icon = doc.createElement('span');
+				icon.className = 'file-icon codicon codicon-file';
+				const pathSpan = doc.createElement('span');
+				pathSpan.className = 'file-path';
+				pathSpan.textContent = change.path;
+				pathSpan.title = change.path;
+				const actionTag = doc.createElement('span');
+				const isDelete = change.action === 'delete';
+				actionTag.className = `action-tag ${isDelete ? 'action-delete' : 'action-restore'}`;
+				actionTag.textContent = isDelete
+					? localize('chat.confirmUndo.actionDelete', "Delete")
+					: localize('chat.confirmUndo.actionRestore', "Restore");
+				item.append(icon, pathSpan, actionTag);
+				fileList.appendChild(item);
+			}
+			card.appendChild(fileList);
+		}
+
+		const footer = doc.createElement('div');
+		footer.className = 'confirm-undo-footer';
+		const cancelBtn = doc.createElement('button');
+		cancelBtn.type = 'button';
+		cancelBtn.className = 'confirm-undo-btn confirm-undo-cancel';
+		cancelBtn.textContent = localize('chat.confirmUndo.cancel', "Cancel");
+		const confirmBtn = doc.createElement('button');
+		confirmBtn.type = 'button';
+		confirmBtn.className = 'confirm-undo-btn confirm-undo-confirm';
+		confirmBtn.textContent = localize('chat.confirmUndo.confirm', "Confirm ↵");
+		footer.append(cancelBtn, confirmBtn);
+		card.appendChild(footer);
+
+		let settled = false;
+		const finish = (result: IConfirmUndoResult) => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			doc.removeEventListener('keydown', onKeyDown, true);
+			backdrop.remove();
+			resolve(result);
+		};
+
+		const onKeyDown = (e: KeyboardEvent) => {
+			if (e.key === 'Escape') {
+				e.preventDefault();
+				e.stopPropagation();
+				finish({ confirmed: false, revertFiles: false });
+			} else if (e.key === 'Enter' && doc.activeElement !== cancelBtn && doc.activeElement !== closeBtn) {
+				e.preventDefault();
+				e.stopPropagation();
+				finish({ confirmed: true, revertFiles: checkbox ? checkbox.checked : true });
+			}
+		};
+
+		backdrop.addEventListener('click', e => {
+			if (e.target === backdrop) {
+				finish({ confirmed: false, revertFiles: false });
+			}
+		});
+		closeBtn.addEventListener('click', () => finish({ confirmed: false, revertFiles: false }));
+		cancelBtn.addEventListener('click', () => finish({ confirmed: false, revertFiles: false }));
+		confirmBtn.addEventListener('click', () => finish({ confirmed: true, revertFiles: checkbox ? checkbox.checked : true }));
+		doc.addEventListener('keydown', onKeyDown, true);
+
+		sessionHost.appendChild(backdrop);
+		confirmBtn.focus();
+	});
+}
