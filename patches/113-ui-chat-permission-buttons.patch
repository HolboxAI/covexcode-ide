+							overlay = document.createElement('div');
+							overlay.className = 'covexcode-permission-floating-overlay';
+							inputPart.prepend(overlay);
+						}
+						overlay.replaceChildren(container);
+						container.classList.add('covexcode-permission-card-floating');
+						container.tabIndex = -1;
+
+						const onKeyDown = (e: KeyboardEvent) => {
