+/*
+ * covexcode-ide: Antigravity-style floating permission approval card.
+ * Floats as an overlay above the chat input box, completely separate from the message stream.
+ * Features rounded corners, code block syntax highlighting, numbered option rows, and subtle hover states.
+ */
+
+/* Floating overlay container above chat input */
+.covexcode-permission-floating-overlay {
+	width: 100% !important;
+	position: relative !important;
+	display: flex !important;
+	flex-direction: column !important;
+	z-index: 40 !important;
+	margin-bottom: 8px !important;
+	animation: covexcode-permission-pop-in 0.18s cubic-bezier(0.16, 1, 0.3, 1) !important;
+}
+
+@keyframes covexcode-permission-pop-in {
+	from { opacity: 0; transform: translateY(6px); }
+	to { opacity: 1; transform: translateY(0); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+	.covexcode-permission-floating-overlay {
+		animation: none !important;
+	}
+	.covexcode-permission-card-floating a {
+		transition: none !important;
+	}
+}
+
+/* Permission card container */
+.covexcode-permission-card-floating,
+.interactive-session .rendered-markdown:has(
+	a[href*="covexcode.permission.respond"],
+	a[data-href*="covexcode.permission.respond"],
+	a[href*="covexcode.permissionAlways.respond"],
+	a[data-href*="covexcode.permissionAlways.respond"],
+	a[href*="covexcode.permission.respondAlways"],
+	a[data-href*="covexcode.permission.respondAlways"],
+	a[href*="permission.respond"],
+	a[data-href*="permission.respond"]
+) {
+	background: var(--vscode-editor-background) !important;
+	border: 1px solid var(--vscode-panel-border) !important;
+	border-radius: 8px !important;
+	padding: 12px 16px !important;
+	margin: 8px 0 !important;
+	box-sizing: border-box !important;
+}
+
+/* Card header */
+.covexcode-permission-card-floating h3,
+.rendered-markdown:has(a[data-href*="permission.respond"]) h3,
+.rendered-markdown:has(a[href*="permission.respond"]) h3 {
+	margin: 0 0 10px 0 !important;
+	font-size: 13px !important;
+	font-weight: 600 !important;
+	color: var(--vscode-foreground) !important;
+	display: flex !important;
+	align-items: center !important;
+	gap: 6px !important;
+}
+
+/* Code block inside the card */
+.covexcode-permission-card-floating pre,
+.covexcode-permission-card-floating code,
+.interactive-session .rendered-markdown:has(
+	a[href*="covexcode.permission.respond"],
+	a[data-href*="covexcode.permission.respond"],
+	a[href*="permission.respond"],
+	a[data-href*="permission.respond"]
+) pre,
+.interactive-session .rendered-markdown:has(
+	a[href*="covexcode.permission.respond"],
+	a[data-href*="covexcode.permission.respond"],
+	a[href*="permission.respond"],
+	a[data-href*="permission.respond"]
+) code {
+	background: var(--vscode-textCodeBlock-background) !important;
+	border-radius: 4px !important;
+	padding: 8px 12px !important;
+	margin: 8px 0 !important;
+	font-family: var(--vscode-editor-font-family, monospace) !important;
+	font-size: var(--vscode-editor-font-size, 12px) !important;
+	overflow-x: auto !important;
+	white-space: pre !important;
+}
+
+/* Numbered option rows */
+.covexcode-permission-card-floating p,
+.interactive-session .rendered-markdown:has(
+	a[href*="covexcode.permission.respond"],
+	a[data-href*="covexcode.permission.respond"],
+	a[href*="covexcode.permission.respondAlways"],
