+	margin: 2px 0 !important;
+	transition: background-color 0.12s ease !important;
+}
+
+.covexcode-permission-card-floating p:hover,
+.interactive-session .rendered-markdown:has(
+	a[href*="covexcode.permission.respond"],
+	a[data-href*="covexcode.permission.respond"],
+	a[href*="covexcode.permission.respondAlways"],
+	a[data-href*="covexcode.permission.respondAlways"],
+	a[href*="permission.respond"],
