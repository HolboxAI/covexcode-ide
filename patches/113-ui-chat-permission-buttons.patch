+				}
+				element.addEventListener('click', () => {
+					const card = element.closest('.covexcode-permission-card-floating, .rendered-markdown') as HTMLElement | null;
+					if (card) {
+						card.remove();
+					}
+				});
+			}
 		});
 
 		return {
