+			const href = element.getAttribute('data-href') || element.getAttribute('href') || '';
+			if (href.includes('permission.respond')) {
+				const container = element.closest('.rendered-markdown') as HTMLElement | null;
+				if (container && !container.classList.contains('covexcode-permission-card-docked')) {
+					container.classList.add('covexcode-permission-card-docked');
+					const session = (element.closest('.interactive-session') || document.querySelector('.interactive-session')) as HTMLElement | null;
+					const inputPart = session?.querySelector('.interactive-input-part') as HTMLElement | null;
