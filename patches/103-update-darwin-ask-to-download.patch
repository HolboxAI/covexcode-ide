+/**
+ * Squirrel.Mac can only install updates for an app signed with a Developer ID
+ * (or an App Store distribution certificate). Ad-hoc and unsigned builds
+ * cannot, so they keep the old "open the download page" fallback. The answer
+ * cannot change while the process is running, so cache it.
+ */
+let canUseSquirrelCache: boolean | undefined;
+function canUseSquirrel(): boolean {
+	if (canUseSquirrelCache !== undefined) {
+		return canUseSquirrelCache;
+	}
+	try {
+		const result = spawnSync('/usr/bin/codesign', ['-dv', '--verbose=4', electron.app.getPath('exe')], { encoding: 'utf8' });
+		const details = `${result.stdout ?? ''}\n${result.stderr ?? ''}`;
+		canUseSquirrelCache = details.includes('Authority=Developer ID Application') || details.includes('Authority=Apple Distribution');
+	} catch {
+		canUseSquirrelCache = false;
+	}
+	return canUseSquirrelCache ?? false;
+}
