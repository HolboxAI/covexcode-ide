diff --git a/build/azure-pipelines/linux/setup-env.sh b/build/azure-pipelines/linux/setup-env.sh
index 2f275d1..f8a85b1 100644
--- a/build/azure-pipelines/linux/setup-env.sh
+++ b/build/azure-pipelines/linux/setup-env.sh
@@ -38,8 +38,24 @@ cat > "$HOME/.gyp/include.gypi" << 'EOF'
 EOF
 
 if [ "$npm_config_arch" == "x64" ]; then
-  # Download clang based on chromium revision used by vscode
-  curl -s https://raw.githubusercontent.com/chromium/chromium/148.0.7778.97/tools/clang/scripts/update.py | python - --output-dir=$PWD/.build/CR_Clang --host-os=linux
+  # Download clang based on chromium revision used by vscode. GitHub's raw
+  # endpoint rate-limits shared CI IPs (HTTP 429), and a piped curl would hide
+  # its own failure behind python's exit status. Fetch to a file with --fail,
+  # retry, authenticate when a token is present, and read it over stdin so
+  # update.py still sees the same __file__/cwd it did before. Tracing is off
+  # around the request so `set -x` cannot print the token.
+  set +x
+  CURL_AUTH=()
+  if [ -n "${GITHUB_TOKEN:-}" ]; then
+    CURL_AUTH=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
+  fi
+  UPDATE_PY=$(mktemp)
+  curl -fsSL --retry 5 --retry-delay 2 "${CURL_AUTH[@]}" \
+    https://raw.githubusercontent.com/chromium/chromium/148.0.7778.97/tools/clang/scripts/update.py \
+    -o "${UPDATE_PY}"
+  set -x
+  python - --output-dir=$PWD/.build/CR_Clang --host-os=linux < "${UPDATE_PY}"
+  rm -f "${UPDATE_PY}"
 
   # Download libcxx headers and objects from upstream electron releases
   DEBUG=libcxx-fetcher \
